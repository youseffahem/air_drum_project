# Space Drums allowed-dependency layers (docs/architecture/architecture.md section 2.2 / 2.4).
# Enforced by import-linter (`lint-imports`) in tests/architecture/test_import_layers.py from
# Phase 02 on; a violation fails the gate (integrity item I-2). Layers in parentheses are
# optional: the package does not exist yet and the contract needs no edit when its phase adds it.
# The forbidden-import contracts prediction -> geometry ("no-peek") and commit -> perception
# ("commit-blind") were added by Phase 05 together with the packages they constrain
# (architecture.md section 2.4).

[importlinter]
root_package = spacedrums

# Phase 18: spacedrums.live_eval (confirmatory analysis over the frozen eval harness, live-experiment
# tooling) sits beside app in the top layer; the two never import each other (ADR-0042 D4).
[importlinter:contract:layers]
name = Space Drums pipeline layers
type = layers
layers =
    spacedrums.app | spacedrums.live_eval
    spacedrums.ui | (spacedrums.eval) | (spacedrums.data) | (spacedrums.calib)
    spacedrums.commit | (spacedrums.audio)
    spacedrums.prediction | spacedrums.models
    (spacedrums.features) | (spacedrums.geometry)
    (spacedrums.tracking)
    (spacedrums.stick)
    (spacedrums.hands)
    spacedrums.capture
    spacedrums.timing | spacedrums.config
    spacedrums.contracts

# Architecture section 2.2 already permits read-only zone access from features.
# Keep the exception narrow: registry/surface types, never candidate generation.
ignore_imports =
    spacedrums.features.core -> spacedrums.geometry.zones
    spacedrums.features.schema -> spacedrums.geometry.zones

[importlinter:contract:contracts-is-leaf]
name = contracts imports nothing else in spacedrums
type = forbidden
source_modules =
    spacedrums.contracts
forbidden_modules =
    spacedrums.timing
    spacedrums.config
    spacedrums.capture
    spacedrums.ui

[importlinter:contract:l0-imports-only-contracts]
name = timing and config import only contracts
type = forbidden
source_modules =
    spacedrums.timing
    spacedrums.config
forbidden_modules =
    spacedrums.capture
    spacedrums.ui

[importlinter:contract:capture-knows-nothing-downstream]
name = capture imports only L0
type = forbidden
source_modules =
    spacedrums.capture
forbidden_modules =
    spacedrums.ui

[importlinter:contract:no-peek]
name = prediction must not import geometry (a predictor cannot peek at zones)
type = forbidden
source_modules =
    spacedrums.prediction
    spacedrums.models
forbidden_modules =
    spacedrums.geometry

[importlinter:contract:labels-are-offline]
name = no causal stage may import the offline label machinery (Phase 07)
type = forbidden
source_modules =
    spacedrums.capture
    spacedrums.hands
    spacedrums.stick
    spacedrums.tracking
    spacedrums.geometry
    spacedrums.prediction
    spacedrums.models
    spacedrums.commit
    spacedrums.audio
    spacedrums.app
    spacedrums.features
forbidden_modules =
    spacedrums.data.labels
    spacedrums.data.splits

[importlinter:contract:commit-blind]
name = commit sees only StrikeCandidate + TrackState (never perception, prediction or features)
type = forbidden
source_modules =
    spacedrums.commit
forbidden_modules =
    spacedrums.hands
    spacedrums.stick
    spacedrums.prediction
    spacedrums.features
